# Directories
bin/
logs/
.vscode/
.engram/
.copilot/
.env
.env.*
!.env.example
.mcp.json

# Plugin .mcp.json is intentionally tracked (distinct from local dev config)
!plugin/.mcp.json

# npm wrapper bin/ contains JS (not compiled binaries) — track it
!npm/backlogit-mcp/bin/

# Project files
*.prj
*.pui
*.code-workspace

.test-output.txt
.test-out.txt
*.pr-comments.json
.pr-comments.json
.copilot-tracking/pr/**/pr-reference.xml

# Build artifacts
*.exe
backlogit

# Ephemeral SQLite databases (always regenerated; never commit)
backlogit.db
.backlogit/backlogit.db
.backlogit/backlogit.db-shm
.backlogit/backlogit.db-wal

# Runtime state (per-consumer checkpoints, not committed)
.backlogit/runtime/
*.exe~
prompt.md

# Advisory file locks (autoharness concurrency protocol)
.*.lock

# Machine-local telemetry harvest checkpoint (changes per machine/run)
.backlogit/.telemetry-checkpoint.json
