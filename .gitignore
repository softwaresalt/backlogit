# Directories
bin/
.bin/
logs/
.vscode/
.copilot/
.claude/
.github/copilot/settings.local.json
.mcp.json
.github/copilot/
tools/mcp/node_modules/
tools/mcp/*.lock
!tools/mcp/bun.lock

# Local environment files (secrets) — never commit. Only .env.example may be tracked.
.env
.env.*
!.env.example
.openai-token

# Project files
*.prj
*.pui
*.code-workspace

.test-output.txt
.test-out.txt
*.pr-comments.json
.pr-comments.json
.copilot-tracking/pr/**/pr-reference.xml

# Build artifacts
*.exe
backlogit

# Ephemeral SQLite databases (always regenerated; never commit)
backlogit.db
.backlogit/backlogit.db
.backlogit/backlogit.db-shm
.backlogit/backlogit.db-wal
.backlogit/review/

# Runtime state (per-consumer checkpoints, not committed)
.backlogit/runtime/
.gsd/staging/
.gsd/backups/
.gsd/gates/pre-review/
.gsd/gates/bootstrap-grant-consumption/
.gsd/gates/pipeline-topology-force-audit.log
*.exe~
prompt.md

# Advisory file locks (GSD concurrency protocol)
.*.lock
.backlogit/.locks/

# Machine-local telemetry harvest checkpoint (changes per machine/run)
.backlogit/.telemetry-checkpoint.json
# Unbounded local telemetry event log (not development or documentation state)
.backlogit/telemetry.jsonl

# Engram runtime data (keep templates/, registry.yaml, .version)
.engram/
!.engram/.version
!.engram/.workspace-id
!.engram/config.toml
!.engram/registry.yaml

# kbdb — managed by kbdb install
.graphtor/
diff.txt
.gitignore.noop

