# Directories
bin/
logs/
.vscode/
.copilot/
.github/copilot/settings.local.json
.mcp.json

# Local environment files (secrets) — never commit. Only .env.example may be tracked.
.env
.env.*
!.env.example

# Project files
*.prj
*.pui
*.code-workspace

.test-output.txt
.test-out.txt
*.pr-comments.json
.pr-comments.json
.copilot-tracking/pr/**/pr-reference.xml

# Build artifacts
*.exe
backlogit

# Ephemeral SQLite databases (always regenerated; never commit)
backlogit.db
.backlogit/backlogit.db
.backlogit/backlogit.db-shm
.backlogit/backlogit.db-wal
.backlogit/review/

# Runtime state (per-consumer checkpoints, not committed)
.backlogit/runtime/
.autoharness/staging/
.autoharness/backups/
*.exe~
prompt.md

# Advisory file locks (autoharness concurrency protocol)
.*.lock
.backlogit/.locks/

# Machine-local telemetry harvest checkpoint (changes per machine/run)
.backlogit/.telemetry-checkpoint.json

# Engram runtime data (keep templates/, registry.yaml, .version)
.engram/
!.engram/.version
!.engram/.workspace-id
!.engram/config.toml
!.engram/registry.yaml

# graphtor-docs — managed by graphtor-docs install
.graphtor/
diff.txt
