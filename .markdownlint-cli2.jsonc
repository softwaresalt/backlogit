{
  // markdownlint-cli2 runner options ONLY. The active rule set (P-008: MD001, MD025,
  // MD041) lives in .markdownlint.json and is auto-discovered/merged by cli2.
  //
  // Honor .gitignore so `make md-lint` lints exactly the version-controlled Markdown
  // corpus — the same set CI sees in a fresh checkout. Without this, cli2's "**/*.md"
  // glob also walks local, gitignored scratch output (.copilot/, .autoharness/, logs/)
  // that never reaches the repo, producing false local failures and local/CI drift.
  //
  // This is NOT a scoped-rollout ignore list: there is no per-directory "ignores"
  // array, no path classifier, and no rollout allowlist. The gate is repo-wide over
  // every tracked Markdown file.
  "gitignore": true
}
