{
  // markdownlint-cli2 runner options ONLY. The active rule set (P-008: MD001, MD025,
  // MD041) lives in .markdownlint.json and is auto-discovered/merged by cli2.
  //
  // Honor .gitignore so `make md-lint` skips gitignored scratch (.copilot/,
  // logs/, .autoharness/staging/, .autoharness/backups/) that never reaches the
  // repo. cli2 then lints the
  // NON-GITIGNORED Markdown corpus: in a clean checkout (CI) that equals exactly
  // the tracked set (0 violations, verified); locally it ALSO covers new/untracked
  // non-ignored Markdown, which is intentional — violations are caught before the
  // file is committed. Genuine local scratch not destined for the repo must be
  // gitignored. Without this option, cli2's "**/*.md" glob would also walk the
  // gitignored scratch above and produce false local failures / local-vs-CI drift.
  //
  // This is NOT a scoped-rollout ignore list: there is no per-directory "ignores"
  // array, no path classifier, and no rollout allowlist. The gate is repo-wide.
  "gitignore": true
}
