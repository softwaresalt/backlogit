+        self.assertTrue(all(row[2] != 0 for row in native_trace))
+        self.assertEqual(native["execution_state_thread_id"], owner)
+        self.assertEqual(native["execution_state_clear_thread_id"], owner)
+        self.assertEqual(native["execution_state_hold_result"], native_trace[0][2])
+        self.assertEqual(native["execution_state_clear_result"], native_trace[1][2])
+        self.assertTrue(native["execution_state_held"] and native["execution_state_cleared"])
+        self.assertEqual(output, ["u1h-owned-ok\n"])
+        with (native_directory / "native-result.json").open("x", encoding="utf-8", newline="\n") as stream:
