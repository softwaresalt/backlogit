+        native_directory = RUNNER._ROOT / "bin" / "tmp" / ("hn" + uuid.uuid4().hex[:6])
+        native_directory.mkdir(exist_ok=False)
+        native_trace = []
+        real_windll = ctypes.WinDLL
+
+        class KernelProxy:
+            def __init__(self, kernel):
+                self.kernel = kernel
+
+            def __getattr__(self, name):
+                return getattr(self.kernel, name)
+
+            @property
+            def SetThreadExecutionState(self):
+                function = self.kernel.SetThreadExecutionState
+                function.argtypes, function.restype = [ctypes.c_ulong], ctypes.c_ulong
+
+                def call(flags):
+                    result = function(flags)
+                    native_trace.append((flags, threading.get_ident(), result))
+                    return result
+
+                return call
+
+        def windll(name, **kwargs):
+            kernel = real_windll(name, **kwargs)
+            return KernelProxy(kernel) if name == "kernel32" else kernel
+
+        output = []
+        with mock.patch.object(RUNNER.ctypes, "WinDLL", side_effect=windll):
+            native = RUNNER._supervise(
